# Copy to .env (repo root). Everything here is optional for local dev:
# with nothing set, the server runs in-memory with a mock Dial client.

PORT=8787
ORG_NAME=Demo Bank

# ── Dial (https://getdial.ai) ───────────────────────────────────────────
DIAL_API_KEY=            # sk_live_...  (leave empty to run in MOCK mode)
DIAL_NUMBER=             # the Dial number callers dial, E.164 e.g. +14155550100. SMS codes are sent from it
DIAL_WEBHOOK_SECRET=     # whsec_... shown when you create the webhook; verifies X-Dial-Signature
# DIAL_API_BASE=https://api.getdial.ai/api/v1   # Dial's docs show both /v1 and /api/v1 paths; change if calls 404

# ── Security ────────────────────────────────────────────────────────────
# Protects /mcp. Put it in Dial's Context MCP config as header "X-Mcp-Secret: <value>",
# or bake it into the URL: https://your-host/mcp/<value>   (use the URL form if headers don't stick)
MCP_SHARED_SECRET=change-me
# REQUIRE_INBOUND=true   # only allow tool calls when Dial says X-Dial-Direction: inbound

# ── Priority scoring (all shown on the dashboard) ───────────────────────
AGING_PER_MIN=2          # points per minute waited. Raise it for the demo so aging is visible
AGING_CAP=150
AVG_HANDLE_MIN=4         # drives the "we'll call you in about N minutes" estimate
REPS_ON_SHIFT=1

# ── Storage ─────────────────────────────────────────────────────────────
STORE=memory             # memory | supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # server only. Never put this in the web app

# ── Demo-day safety nets ────────────────────────────────────────────────
# If SMS delivery fails on stage, the code is shown on the dashboard so the call can continue.
DEMO_SHOW_CODES=false
# SEED_FILE=./seed.json   # your teammates' real numbers (copy server/seed.example.json)

# CORS_ORIGIN=https://your-dashboard.vercel.app   # default * (fine for a demo)
# WEB_DIST=../web/dist    # serve the built dashboard from this server too (single-deploy mode)
