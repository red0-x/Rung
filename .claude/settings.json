{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/scripts/vault-catchup.sh" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/scripts/vault-check.sh" }]
      }
    ]
  }
}
