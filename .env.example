# Rung environment. Copy to .env (gitignored) and fill in. Never commit real values.

# ── Server ──────────────────────────────────────────────
PORT=8787
# development | production. Production refuses to boot without MCP_SHARED_SECRET and Supabase
# credentials, never enables dev auth, and answers 503 on /webhooks/dial until DIAL_WEBHOOK_SECRET is set.
NODE_ENV=development
# Public base URL (Dial reaches /mcp and /webhooks/dial here). Production: https://rung-liart.vercel.app
PUBLIC_URL=http://localhost:8787
# Comma-separated dashboard origins, or * (dev).
CORS_ORIGIN=*
# memory | supabase. Default: supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
STORE=
# Seed Demo Bank + Northside Clinic on boot (idempotent).
SEED_ON_BOOT=true
# Dev conveniences: `Authorization: Bearer dev:<email>` and POST /api/dev/reset. Forced off in production.
ENABLE_DEV=true
# Only accept tool calls Dial marks as inbound.
REQUIRE_INBOUND=true
# Optional override of the agent prompt template (default: docs/inbound-prompt.md).
PROMPT_TEMPLATE_PATH=
# Process Dial webhooks before answering 200 (default: on when running on Vercel, i.e. VERCEL is set).
INLINE_WEBHOOKS=

# ── Supabase (Postgres + Auth) ──────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase CLI only (supabase db push).
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# ── Dial ───────────────────────────────────────────────
# Blank = mock client (SMS, PATCH /numbers and GET /calls are recorded, not sent).
DIAL_API_KEY=
DIAL_API_BASE=https://api.getdial.ai/api/v1
# whsec_... from the webhook subscription. Without it production answers 503 on /webhooks/dial.
DIAL_WEBHOOK_SECRET=
# JSON list of pre-provisioned numbers the setup wizard can claim: [{"id":"...","number":"+1..."}]
# Blank = two fake numbers flagged mock.
DIAL_NUMBER_POOL=
# true = use the mock client even when DIAL_API_KEY is set (local testing).
DIAL_MOCK=
# Static header X-Mcp-Secret on the account's Context MCP (<PUBLIC_URL>/mcp). Required in production.
MCP_SHARED_SECRET=
# Texted-code verification (send_code/check_code tools, code gate on sensitive intents). Default false:
# SMS to regular phones needs 10DLC. Off = callers are recognized by number, profiles saved with consent only.
REQUIRE_VERIFICATION=false
# When verification is on: show texted codes on the dashboard as a delivery fallback. Default true.
DEMO_SHOW_CODES=true

# ── Demo users (Supabase Auth, linked to the seeded orgs) ─
DEMO_BANK_EMAIL=bank@rung.demo
DEMO_CLINIC_EMAIL=clinic@rung.demo
DEMO_PASSWORD=

# ── Web (Vite) ──────────────────────────────────────────
# Empty = same origin (/api). The Vercel build forces ''. Local dev proxies /api to :8787.
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
